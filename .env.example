# Supabase Configuration (Vite uses VITE_ prefix)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional external tracking API.
# Expected endpoint format: GET https://your-api.com/tracking?fiscalKey=...
VITE_TRACKING_API_URL=


# Defaults to enabled for the exact official hostname after the approved release.
# Set false to temporarily disable indexing, including on the official domain.
# SEO_INDEXING_ENABLED=false
