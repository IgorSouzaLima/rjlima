# Supabase Configuration (Vite uses VITE_ prefix)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional external tracking API.
# Expected endpoint format: GET https://your-api.com/tracking?fiscalKey=...
VITE_TRACKING_API_URL=

# EmailJS Configuration (https://www.emailjs.com/)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
